# FarmVision AI Backend - Local Development
# Copy this file to .env and fill in values on your own machine.
# Do not commit .env or paste real credentials into source files.

# PostgreSQL connection (Prisma adapter-pg)
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/farmvision_dev?schema=public"

# Public origin used in verification, password-reset, and account emails
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Allowed CORS origins for auth requests
APP_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# JWT secret for session signing (generate a unique random string)
FARMVISION_JWT_SECRET="replace-with-a-long-random-secret"

# SMTP configuration for email verification / password reset
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="FarmVision AI <noreply@example.com>"
