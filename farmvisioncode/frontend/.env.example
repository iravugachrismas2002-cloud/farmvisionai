# Copy this file to .env and fill in the local values yourself.
# URL-encode special characters in the PostgreSQL password.
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# Required for signing application sessions. Generate a unique secret locally.
FARMVISION_JWT_SECRET="replace-with-a-long-random-secret"

# Must exactly match the browser origin used for local development.
APP_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://192.168.99.179:3000"

# Public origin used in verification, password-reset, and account emails.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Configure a real SMTP provider before enabling account email flows.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="FarmVision AI <noreply@example.com>"
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
